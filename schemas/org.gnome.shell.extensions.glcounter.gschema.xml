<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.glcounter" path="/org/gnome/shell/extensions/glcounter/">

    <key name="instances" type="s">
      <default>'[]'</default>
      <summary>JSON array of Gitlab instances. Each instance has its own list of counters.</summary>
    </key>

    <key name="poll-interval" type="i">
      <default>300</default>
      <range min="30" max="3600"/>
      <summary>Polling interval in seconds</summary>
    </key>

  </schema>
</schemalist>
